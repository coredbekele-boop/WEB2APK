# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / APP_BASE_URL: The base URL where this applet is hosted.
APP_URL="MY_APP_URL"
APP_BASE_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL or MongoDB connection string
DATABASE_URL="postgresql://user:password@localhost:5432/web2apk"

# Firebase Credentials (for Auth, Firestore & Cloud Storage)
FIREBASE_PROJECT_ID="web2apk-production"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@web2apk-production.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
STORAGE_BUCKET="web2apk-production.appspot.com"

# Build Worker & Queue Configuration
BUILD_QUEUE_URL="redis://localhost:6379"
BUILD_WORKER_URL="http://localhost:8080"
ANDROID_SIGNING_KEYSTORE_PASSWORD="optional-keystore-password"
JWT_SECRET="super-secret-jwt-token-signing-key"

