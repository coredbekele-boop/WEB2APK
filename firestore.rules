rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile validation
    function isValidUser(data) {
      return data.id is string && data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 150;
    }

    // Project validation
    function isValidProject(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.websiteUrl is string && data.websiteUrl.size() > 0 && data.websiteUrl.size() <= 500 &&
             data.packageName is string && data.packageName.size() > 0 && data.packageName.size() <= 120;
    }

    // Build validation
    function isValidBuild(data) {
      return data.id is string && isValidId(data.id) &&
             data.projectId is string && isValidId(data.projectId) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.platform in ['android', 'ios'] &&
             data.status in ['queued', 'building', 'success', 'failed'];
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().id == existing().id;
      allow delete: if isOwner(userId);
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidProject(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid &&
                       isValidProject(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Builds collection
    match /builds/{buildId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidBuild(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid &&
                       isValidBuild(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
